{
  "name": "stable-api",
  "version": "0.1.0",
  "private": true,
  "description": "API do Stable — empréstimo de equipamentos de TI (PT-BR)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.1",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-express": "^10.4.1",
    "@prisma/client": "^6.0.0",
    "@vendia/serverless-express": "^4.12.6",
    "helmet": "^8.0.0",
    "jose": "^5.9.3",
    "nestjs-zod": "^5.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "pino": "^9.4.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.1",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
